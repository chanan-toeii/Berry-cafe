        <label style="font-size:11.5px;color:var(--copper-dark);text-transform:uppercase;letter-spacing:.05em;font-weight:600;">ราคาต่อแก้ว (บาท)</label>
        <input type="number" id="modal-price-input" min="0" step="1" value="${state.settings.pricePerCup||''}" style="width:100%;margin-top:6px;border:1px solid var(--line);background:var(--white);border-radius:9px;padding:9px 11px;font-family:'IBM Plex Mono',monospace;font-size:14.5px;">
      </div>

      <div style="margin-top:18px;">
        <label style="font-size:11.5px;color:var(--copper-dark);text-transform:uppercase;letter-spacing:.05em;font-weight:600;">การเชื่อมต่อ Google ชีต</label>
        <p style="margin-top:4px;">ข้อมูลทั้งหมดอ่าน/เขียนตรงไปที่สเปรดชีตของคุณผ่าน Apps Script</p>
        <input type="text" id="modal-url-input" value="${escapeHtml(getScriptUrl())}" placeholder="https://script.google.com/macros/s/xxxxx/exec" style="width:100%;margin-top:6px;border:1px solid var(--line);background:var(--white);border-radius:9px;padding:9px 11px;font-family:'IBM Plex Mono',monospace;font-size:12.5px;">
        <button class="btn btn-ghost" data-action="save-modal-url" style="margin-top:8px;width:100%;justify-content:center;">บันทึกลิงก์เชื่อมต่อ</button>
      </div>

      <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--line);">
        <button class="btn btn-danger-ghost" data-action="reset-all" style="width:100%;justify-content:center;">${ICONS.trash} ล้างข้อมูลทั้งหมดในชีต</button>
      </div>

      <div class="modal-close-row">
        <button class="btn btn-primary" data-action="close-modal">เสร็จสิ้น</button>
      </div>
    </div>
  </div>`;
}

/* ---------------------------------------------------------------
   EVENTS
---------------------------------------------------------------- */
function attachEvents(){
  document.querySelectorAll('[data-tab]').forEach(el=>{
    el.addEventListener('click', ()=>{ state.tab = el.getAttribute('data-tab'); render(); });
  });

  const settingsBtn = document.querySelectorAll('[data-action="open-settings"]');
  settingsBtn.forEach(b=> b.addEventListener('click', ()=>{ state.modal='settings'; render(); }));

  document.querySelectorAll('[data-action="close-modal"]').forEach(b=>{
    b.addEventListener('click', (e)=>{ if(e.target===b){ state.modal=null; render(); } });
  });

  const equipForm = document.getElementById('equip-form');
  if(equipForm){
    equipForm.addEventListener('submit', async (e)=>{
      e.preventDefault();
      const fd = new FormData(equipForm);
      const item = { id:uid(), name:fd.get('name').trim(), cost:Number(fd.get('cost')), date:fd.get('date')||todayISO() };
      if(!item.name || isNaN(item.cost)) return;
      state.equipment.push(item);
      render();
      try{ await apiPost({ action:'add', sheet:'equipment', data:item }); }catch(err){ notifySyncError(); }
    });
  }

  const beanForm = document.getElementById('bean-form');
  if(beanForm){
    beanForm.addEventListener('submit', async (e)=>{
      e.preventDefault();
      const fd = new FormData(beanForm);
      const item = { id:uid(), name:fd.get('name').trim(), cost:Number(fd.get('cost')), weight: fd.get('weight')? Number(fd.get('weight')) : null, date:fd.get('date')||todayISO() };
      if(!item.name || isNaN(item.cost)) return;
      state.beans.push(item);
      render();
      try{ await apiPost({ action:'add', sheet:'beans', data:item }); }catch(err){ notifySyncError(); }
    });
  }

  const cupForm = document.getElementById('cup-form');
  if(cupForm){
    cupForm.addEventListener('submit', async (e)=>{
      e.preventDefault();
      const fd = new FormData(cupForm);
      const item = { id:uid(), qty:Number(fd.get('qty'))||1, date:fd.get('date')||todayISO(), note:(fd.get('note')||'').trim() };
      state.cups.push(item);
      render();
      try{ await apiPost({ action:'add', sheet:'cups', data:item }); }catch(err){ notifySyncError(); }
    });
  }

  const quickAdd = document.querySelector('[data-action="quick-add-cup"]');
  if(quickAdd){
    quickAdd.addEventListener('click', async ()=>{
      const item = { id:uid(), qty:1, date:todayISO(), note:'' };
      state.cups.push(item);
      render();
      try{ await apiPost({ action:'add', sheet:'cups', data:item }); }catch(err){ notifySyncError(); }
    });
  }

  document.querySelectorAll('[data-action="del-equipment"]').forEach(b=>{
    b.addEventListener('click', async ()=>{
      const id = b.getAttribute('data-id');
      state.equipment = state.equipment.filter(i=>i.id!==id);
      render();
      try{ await apiPost({ action:'delete', sheet:'equipment', id }); }catch(err){ notifySyncError(); }
    });
  });
  document.querySelectorAll('[data-action="del-bean"]').forEach(b=>{
    b.addEventListener('click', async ()=>{
      const id = b.getAttribute('data-id');
      state.beans = state.beans.filter(i=>i.id!==id);
      render();
      try{ await apiPost({ action:'delete', sheet:'beans', id }); }catch(err){ notifySyncError(); }
    });
  });
  document.querySelectorAll('[data-action="del-cup"]').forEach(b=>{
    b.addEventListener('click', async ()=>{
      const id = b.getAttribute('data-id');
      state.cups = state.cups.filter(i=>i.id!==id);
      render();
      try{ await apiPost({ action:'delete', sheet:'cups', id }); }catch(err){ notifySyncError(); }
    });
  });

  const priceInput = document.getElementById('price-input');
  if(priceInput){
    priceInput.addEventListener('change', async ()=>{
      state.settings.pricePerCup = Number(priceInput.value)||0;
      render();
      try{ await apiPost({ action:'setSetting', key:'pricePerCup', value:state.settings.pricePerCup }); }catch(err){ notifySyncError(); }
    });
  }
  const modalPriceInput = document.getElementById('modal-price-input');
  if(modalPriceInput){
    modalPriceInput.addEventListener('change', async ()=>{
      state.settings.pricePerCup = Number(modalPriceInput.value)||0;
      try{ await apiPost({ action:'setSetting', key:'pricePerCup', value:state.settings.pricePerCup }); }catch(err){ notifySyncError(); }
    });
  }

  const saveUrlBtn = document.querySelector('[data-action="save-modal-url"]');
  if(saveUrlBtn){
    saveUrlBtn.addEventListener('click', async ()=>{
      const val = document.getElementById('modal-url-input').value.trim();
      setScriptUrl(val);
      state.modal = null;
      state.loading = true;
      render();
      await loadAll();
      render();
    });
  }

  const resetBtn = document.querySelector('[data-action="reset-all"]');
  if(resetBtn){
    resetBtn.addEventListener('click', async ()=>{
      if(!confirm('ล้างข้อมูลอุปกรณ์ เมล็ดกาแฟ และบันทึกแก้วทั้งหมดในชีต? การกระทำนี้ย้อนกลับไม่ได้')) return;
      state.equipment = []; state.beans = []; state.cups = []; state.settings = { pricePerCup:0 };
      state.modal = null;
      render();
      try{ await apiPost({ action:'resetAll' }); }catch(err){ notifySyncError(); }
    });
  }
}

function notifySyncError(){
  alert('บันทึกไปยัง Google ชีตไม่สำเร็จ ตรวจสอบการเชื่อมต่ออินเทอร์เน็ตหรือลิงก์ Apps Script แล้วลองใหม่');
}

/* ---------------------------------------------------------------
   INIT
---------------------------------------------------------------- */
render();
loadAll().then(render);
</script>
</body>
</html>
