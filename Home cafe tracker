<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no">
<title>Home Cafe — บันทึกต้นทุน</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Sans+Thai:wght@400;500;600;700&family=Noto+Serif+Thai:wght@500;600;700&display=swap');

  :root{
    --espresso:#2B1B12;
    --espresso-soft:#4A3226;
    --crema:#F3EADB;
    --crema-soft:#EAE0CC;
    --paper:#FBF7EF;
    --copper:#BE7C3B;
    --copper-dark:#96601F;
    --sage:#6F7D52;
    --sage-dark:#525C3C;
    --rust:#A8432B;
    --line:#DCCEB2;
    --white:#FFFDF9;
    --shadow: 0 1px 2px rgba(43,27,18,.06), 0 6px 20px rgba(43,27,18,.08);
    --radius: 14px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      repeating-linear-gradient(0deg, rgba(43,27,18,0.035) 0px, rgba(43,27,18,0.035) 1px, transparent 1px, transparent 28px),
      repeating-linear-gradient(90deg, rgba(43,27,18,0.035) 0px, rgba(43,27,18,0.035) 1px, transparent 1px, transparent 28px),
      var(--crema);
    color:var(--espresso);
    font-family:'Inter','Noto Sans Thai',sans-serif;
    min-height:100vh;
    -webkit-font-smoothing:antialiased;
  }
  .mono{ font-family:'IBM Plex Mono','Noto Sans Thai',monospace; font-variant-numeric: tabular-nums; }
  .serif{ font-family:'Fraunces','Noto Serif Thai',serif; }

  #app{ display:flex; min-height:100vh; }

  /* ---------- Sidebar (desktop) / Bottom nav (mobile) ---------- */
  .sidenav{
    display:none;
  }
  .brand{
    display:flex; align-items:center; gap:10px; padding:22px 20px 18px 22px;
  }
  .brand-mark{ width:34px; height:34px; flex:none; }
  .brand-text .t1{ font-family:'Fraunces','Noto Serif Thai',serif; font-weight:600; font-size:18px; letter-spacing:.2px; line-height:1.1; color:var(--espresso);}
  .brand-text .t2{ font-size:11px; letter-spacing:.08em; color:var(--copper-dark); text-transform:uppercase; margin-top:2px; }

  .navlist{ list-style:none; margin:8px 0; padding:0 12px; display:flex; flex-direction:column; gap:2px; }
  .navlist button{
    width:100%; display:flex; align-items:center; gap:12px; padding:11px 12px; border:none; background:transparent;
    border-radius:10px; cursor:pointer; font-family:inherit; font-size:14.5px; color:var(--espresso-soft); text-align:left;
    transition:background .15s ease, color .15s ease;
  }
  .navlist button svg{ width:19px; height:19px; flex:none; opacity:.85; }
  .navlist button.active{ background:var(--espresso); color:var(--paper); }
  .navlist button.active svg{ opacity:1; }
  .navlist button:not(.active):hover{ background:var(--crema-soft); }

  .side-footer{ margin-top:auto; padding:16px 22px 22px; font-size:12px; color:var(--copper-dark); line-height:1.5; }

  main{ flex:1; min-width:0; }
  .topbar-mobile{
    display:flex; align-items:center; justify-content:space-between; gap:10px;
    padding:16px 18px 12px; border-bottom:1px solid var(--line);
    background:var(--paper);
    position:sticky; top:0; z-index:5;
  }
  .content-wrap{ max-width:920px; margin:0 auto; padding:20px 18px 100px; }

  h1.page-title{ font-family:'Fraunces','Noto Serif Thai',serif; font-size:26px; font-weight:600; margin:4px 0 4px; color:var(--espresso); }
  p.page-sub{ margin:0 0 22px; color:var(--espresso-soft); font-size:14px; }

  /* ---------- Cards ---------- */
  .card{
    background:var(--white); border:1px solid var(--line); border-radius:var(--radius);
    box-shadow:var(--shadow); padding:18px 18px;
  }
  .stat-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:12px; margin-bottom:16px; }
  @media(min-width:640px){ .stat-grid{ grid-template-columns:repeat(4,1fr);} }
  .stat-card{ background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:15px 16px; box-shadow:var(--shadow); }
  .stat-label{ font-size:11px; text-transform:uppercase; letter-spacing:.07em; color:var(--copper-dark); font-weight:600; display:flex; align-items:center; gap:6px;}
  .stat-label svg{ width:13px;height:13px; }
  .stat-value{ font-family:'IBM Plex Mono',monospace; font-size:22px; font-weight:600; margin-top:6px; color:var(--espresso); }
  .stat-value.rust{ color:var(--rust); }
  .stat-value.sage{ color:var(--sage-dark); }
  .stat-note{ font-size:11.5px; color:var(--espresso-soft); margin-top:3px; }

  .section-title{ font-family:'Fraunces','Noto Serif Thai',serif; font-size:17px; font-weight:600; margin:26px 0 12px; display:flex; align-items:center; gap:8px;}

  /* ---------- Chart ---------- */
  .chart-card{ margin-top:4px; }
  .chart-legend{ display:flex; gap:18px; font-size:12.5px; margin-bottom:10px; flex-wrap:wrap; }
  .chart-legend span{ display:flex; align-items:center; gap:6px; color:var(--espresso-soft); }
  .swatch{ width:14px; height:3px; border-radius:2px; display:inline-block; }
  .empty-chart{ text-align:center; padding:40px 10px; color:var(--espresso-soft); }
  .empty-chart svg{ width:46px;height:46px; opacity:.35; margin-bottom:10px; }
  .empty-chart .cta{ margin-top:14px; }

  /* ---------- Forms ---------- */
  .form-row{ display:flex; flex-wrap:wrap; gap:10px; margin-bottom:14px; }
  .field{ display:flex; flex-direction:column; gap:5px; flex:1 1 130px; }
  .field label{ font-size:11.5px; color:var(--copper-dark); text-transform:uppercase; letter-spacing:.05em; font-weight:600; }
  .field input{
    border:1px solid var(--line); background:var(--paper); border-radius:9px; padding:9px 11px;
    font-family:'IBM Plex Mono',monospace; font-size:14.5px; color:var(--espresso); outline:none;
  }
  .field input[type=text]{ font-family:'Inter','Noto Sans Thai',sans-serif; }
  .field input:focus{ border-color:var(--copper); box-shadow:0 0 0 3px rgba(190,124,59,.15); }
  .btn{
    border:none; border-radius:9px; padding:9px 16px; font-family:inherit; font-size:14px; font-weight:600;
    cursor:pointer; display:inline-flex; align-items:center; gap:7px; transition:opacity .15s, transform .1s;
  }
  .btn:active{ transform:scale(.97); }
  .btn-primary{ background:var(--espresso); color:var(--paper); }
  .btn-primary:hover{ opacity:.9; }
  .btn-copper{ background:var(--copper); color:var(--white); }
  .btn-copper:hover{ opacity:.9; }
  .btn-ghost{ background:transparent; color:var(--espresso-soft); border:1px solid var(--line); }
  .btn-ghost:hover{ background:var(--crema-soft); }
  .btn-danger-ghost{ background:transparent; border:1px solid var(--line); color:var(--rust); padding:7px 9px; }
  .btn-danger-ghost:hover{ background:#F7E9E4; }
  .btn svg{ width:15px; height:15px; }
  .btn-block{ width:100%; justify-content:center; }
  .btn-big{ padding:16px 20px; font-size:16px; border-radius:12px; }

  /* ---------- Lists ---------- */
  .list{ display:flex; flex-direction:column; gap:8px; margin-top:4px; }
  .list-row{
    display:flex; align-items:center; justify-content:space-between; gap:10px;
    background:var(--white); border:1px solid var(--line); border-radius:11px; padding:11px 13px;
  }
  .list-row .li-main{ min-width:0; }
  .list-row .li-name{ font-size:14.5px; font-weight:600; color:var(--espresso); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
  .list-row .li-sub{ font-size:12px; color:var(--espresso-soft); margin-top:2px; }
  .list-row .li-right{ display:flex; align-items:center; gap:10px; flex:none; }
  .li-cost{ font-family:'IBM Plex Mono',monospace; font-weight:600; font-size:14.5px; color:var(--espresso); white-space:nowrap; }
  .list-total{
    display:flex; justify-content:space-between; align-items:center; padding:12px 14px; margin-top:2px;
    background:var(--espresso); color:var(--paper); border-radius:11px; font-size:14px;
  }
  .list-total .v{ font-family:'IBM Plex Mono',monospace; font-weight:600; font-size:16px; }
  .empty-list{ text-align:center; padding:28px 10px; color:var(--espresso-soft); font-size:13.5px; border:1px dashed var(--line); border-radius:11px; }

  /* ---------- Cup tab ---------- */
  .cup-hero{
    background:linear-gradient(155deg,var(--espresso),var(--espresso-soft));
    border-radius:16px; padding:22px 20px; color:var(--paper); text-align:center; box-shadow:var(--shadow);
  }
  .cup-hero .cup-count{ font-family:'Fraunces',serif; font-size:52px; font-weight:600; line-height:1; margin:4px 0; }
  .cup-hero .cup-label{ font-size:12px; text-transform:uppercase; letter-spacing:.1em; opacity:.75; }
  .cup-hero .add-btn{
    margin-top:16px; background:var(--copper); border:none; color:var(--white); font-family:'Fraunces',serif;
    font-size:17px; font-weight:600; padding:14px 30px; border-radius:50px; cursor:pointer; display:inline-flex; gap:8px; align-items:center;
    box-shadow:0 6px 18px rgba(190,124,59,.35);
  }
  .cup-hero .add-btn:active{ transform:scale(.96); }
  .cup-hero .add-btn svg{ width:18px;height:18px; }
  .price-box{ display:flex; align-items:center; justify-content:space-between; gap:10px; margin-top:14px; }
  .price-inline{ display:flex; align-items:center; gap:8px; }
  .price-inline input{ width:90px; text-align:right; }

  /* ---------- Tabs bar mobile ---------- */
  .tabbar{
    position:fixed; bottom:0; left:0; right:0; display:flex; background:var(--paper);
    border-top:1px solid var(--line); z-index:20; padding:6px 6px calc(6px + env(safe-area-inset-bottom));
  }
  .tabbar button{
    flex:1; display:flex; flex-direction:column; align-items:center; gap:3px; background:none; border:none;
    color:var(--espresso-soft); font-family:'Inter','Noto Sans Thai',sans-serif; font-size:10.5px; padding:6px 2px; cursor:pointer; border-radius:10px;
  }
  .tabbar button svg{ width:20px;height:20px; }
  .tabbar button.active{ color:var(--copper-dark); }
  .tabbar button.active svg{ transform:translateY(-1px); }

  @media(min-width:860px){
    .sidenav{ display:flex; flex-direction:column; width:230px; flex:none; border-right:1px solid var(--line); background:var(--paper); min-height:100vh; position:sticky; top:0; }
    .topbar-mobile{ display:none; }
    .tabbar{ display:none; }
    .content-wrap{ padding:36px 40px 60px; max-width:960px; }
  }

  /* ---------- Modal ---------- */
  .modal-overlay{ position:fixed; inset:0; background:rgba(43,27,18,.45); display:flex; align-items:flex-end; justify-content:center; z-index:50; }
  @media(min-width:640px){ .modal-overlay{ align-items:center; } }
  .modal{ background:var(--paper); width:100%; max-width:440px; border-radius:18px 18px 0 0; padding:22px 20px 28px; max-height:85vh; overflow:auto; }
  @media(min-width:640px){ .modal{ border-radius:16px; } }
  .modal h3{ font-family:'Fraunces',serif; margin:0 0 4px; font-size:19px; }
  .modal p{ font-size:13.5px; color:var(--espresso-soft); line-height:1.6; }
  .modal-close-row{ display:flex; justify-content:flex-end; margin-top:18px; gap:8px; }
  textarea.csv-box{
    width:100%; height:120px; font-family:'IBM Plex Mono',monospace; font-size:12px; border:1px solid var(--line);
    border-radius:9px; padding:10px; background:var(--white); resize:vertical; margin-top:10px;
  }

  .icon-btn{ background:none; border:none; cursor:pointer; color:var(--espresso-soft); padding:6px; border-radius:8px; display:flex; }
  .icon-btn:hover{ background:var(--crema-soft); }
  .icon-btn svg{ width:19px; height:19px; }

  .loading-screen{ display:flex; align-items:center; justify-content:center; min-height:100vh; flex-direction:column; gap:10px; color:var(--espresso-soft); }
  .loading-screen svg{ width:34px;height:34px; animation:spin 1.1s linear infinite; color:var(--copper); }
  @keyframes spin{ to{ transform:rotate(360deg); } }

  .status-pill{ display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:20px; font-size:12px; font-weight:600; }
  .status-pill.ok{ background:#E8EEE1; color:var(--sage-dark); }
  .status-pill.no{ background:#F4E4DD; color:var(--rust); }
</style>
</head>
<body>
<div id="app"></div>

<script>
/* ---------------------------------------------------------------
   ICONS (inline SVG, stroke-based, matches brand)
---------------------------------------------------------------- */
const ICONS = {
  cup: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8Z"/><path d="M17 9h1.5a2.5 2.5 0 0 1 0 5H17"/><path d="M8 3c-.5 1 .5 1.5 0 2.5S7 7 7.5 8"/><path d="M12 3c-.5 1 .5 1.5 0 2.5S11 7 11.5 8"/></svg>`,
  wrench: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2-2Z"/></svg>`,
  bean: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6c2 2.5 2 10-1 14-4-1-9 0-13-3-2-2.5-2-10 1-14 4 1 9 0 13 3Z"/><path d="M17 5c-3 3-3 12-8 14"/></svg>`,
  log: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6h11M9 12h11M9 18h11"/><path d="M4 6h.01M4 12h.01M4 18h.01"/></svg>`,
  plus: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>`,
  trash: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></svg>`,
  wallet: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h13a1 1 0 0 1 1 1v3M3 7v11a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-6a1 1 0 0 0-1-1h-4a2 2 0 1 0 0 4h5"/></svg>`,
  trend: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8M15 7h6v6"/></svg>`,
  target: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r=".6" fill="currentColor"/></svg>`,
  settings: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg>`,
  x: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>`,
  spinner: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" opacity=".25"/><path d="M21 12a9 9 0 0 0-9-9"/></svg>`,
  flame: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2c1 3-2 4-2 7a3 3 0 0 0 6 0c1 1 2 2.5 2 4.5A5.5 5.5 0 0 1 12 19a5.5 5.5 0 0 1-5.5-5.5C6.5 8 9 6 12 2Z"/></svg>`,
  copy: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>`,
};

/* ---------------------------------------------------------------
   STATE + STORAGE
---------------------------------------------------------------- */
const state = {
  equipment: [],
  beans: [],
  cups: [],
  settings: { pricePerCup: 0 },
  tab: 'dashboard',
  loading: true,
  saving: false,
  modal: null, // 'settings' | null
};

/* ---------------------------------------------------------------
   BACKEND: Google Sheets via Apps Script Web App
   วาง URL ของ Apps Script Web App ที่ deploy แล้วในหน้าตั้งค่าของแอป
   (เก็บไว้ใน localStorage ของเบราว์เซอร์ ไม่ hardcode ในไฟล์)
---------------------------------------------------------------- */
const SCRIPT_URL_KEY = 'homecafe_apps_script_url';
function getScriptUrl(){ return (localStorage.getItem(SCRIPT_URL_KEY) || '').trim(); }
function setScriptUrl(url){ localStorage.setItem(SCRIPT_URL_KEY, (url||'').trim()); }

async function apiGetAll(){
  const url = getScriptUrl();
  const res = await fetch(url + (url.includes('?')?'&':'?') + 'action=getAll');
  if(!res.ok) throw new Error('network');
  const data = await res.json();
  if(data.error) throw new Error(data.error);
  return data;
}
async function apiPost(payload){
  const url = getScriptUrl();
  const res = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
    body: JSON.stringify(payload),
  });
  if(!res.ok) throw new Error('network');
  const data = await res.json();
  if(data.error) throw new Error(data.error);
  return data;
}

async function loadAll(){
  state.loadError = null;
  if(!getScriptUrl()){
    state.needsSetup = true;
    state.loading = false;
    return;
  }
  try{
    const data = await apiGetAll();
    state.equipment = data.equipment || [];
    state.beans = data.beans || [];
    state.cups = data.cups || [];
    state.settings = (data.settings && typeof data.settings === 'object') ? data.settings : { pricePerCup: 0 };
    state.needsSetup = false;
  }catch(e){
    state.loadError = e.message || 'เชื่อมต่อไม่สำเร็จ';
  }
  state.loading = false;
}

function uid(){ return Date.now().toString(36) + Math.random().toString(36).slice(2,7); }
function todayISO(){ return new Date().toISOString().slice(0,10); }
function fmtDate(iso){
  const d = new Date(iso + 'T00:00:00');
  return d.toLocaleDateString('th-TH', { day:'numeric', month:'short', year:'2-digit' });
}
function money(n){
  const v = Number(n)||0;
  const s = v.toLocaleString('th-TH', { minimumFractionDigits: v % 1 === 0 ? 0 : 2, maximumFractionDigits: 2 });
  return '฿' + s;
}

/* ---------------------------------------------------------------
   DERIVED CALCULATIONS
---------------------------------------------------------------- */
function totals(){
  const equipTotal = state.equipment.reduce((s,i)=>s+Number(i.cost||0),0);
  const beansTotal = state.beans.reduce((s,i)=>s+Number(i.cost||0),0);
  const totalCost = equipTotal + beansTotal;
  const totalCups = state.cups.reduce((s,i)=>s+Number(i.qty||0),0);
  const price = Number(state.settings.pricePerCup||0);
  const revenue = totalCups * price;
  const diff = revenue - totalCost;
  const brokeEven = diff >= 0 && totalCost > 0;
  let cupsToBreakEven = null;
  if(!brokeEven && price > 0){
    cupsToBreakEven = Math.ceil((totalCost - revenue) / price);
  }
  return { equipTotal, beansTotal, totalCost, totalCups, price, revenue, diff, brokeEven, cupsToBreakEven };
}

function buildTimeline(){
  const events = [];
  state.equipment.forEach(i => events.push({ type:'cost', amount:Number(i.cost||0), date:i.date, id:i.id, label:i.name }));
  state.beans.forEach(i => events.push({ type:'cost', amount:Number(i.cost||0), date:i.date, id:i.id, label:i.name }));
  state.cups.forEach(i => events.push({ type:'rev', amount:Number(i.qty||0)*Number(state.settings.pricePerCup||0), date:i.date, id:i.id, label:(i.qty||1)+' แก้ว' }));
  events.sort((a,b)=> (a.date < b.date ? -1 : a.date > b.date ? 1 : (a.id < b.id ? -1 : 1)));
  let cost = 0, rev = 0;
  const points = events.map(e=>{
    if(e.type==='cost') cost += e.amount; else rev += e.amount;
    return { date:e.date, cost, rev, type:e.type, label:e.label };
  });
  return points;
}

/* ---------------------------------------------------------------
   RENDER: ROOT
---------------------------------------------------------------- */
function render(){
  const app = document.getElementById('app');
  if(state.loading){
    app.innerHTML = `<div class="loading-screen">${ICONS.spinner}<div class="mono" style="font-size:13px;">กำลังชงข้อมูล...</div></div>`;
    return;
  }
  if(state.needsSetup){
    app.innerHTML = renderSetupScreen();
    attachSetupEvents();
    return;
  }
  if(state.loadError){
    app.innerHTML = renderErrorScreen();
    attachErrorEvents();
    return;
  }
  app.innerHTML = `
    ${renderSidenav()}
    <main>
      ${renderTopbarMobile()}
      <div class="content-wrap">${renderTab()}</div>
      ${renderTabbar()}
    </main>
    ${state.modal ? renderModal() : ''}
  `;
  attachEvents();
}

