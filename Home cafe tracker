function renderChart(){
  const points = buildTimeline();
  if(points.length < 1){
    return `
      <div class="empty-chart">
        ${ICONS.cup}
        <div>ยังไม่มีข้อมูล — เพิ่มเครื่องชงเครื่องแรกของคุณ แล้วกราฟจะเริ่มวาดเส้นทางคืนทุนให้เอง</div>
        <div class="cta"><button class="btn btn-copper" data-tab="equipment">${ICONS.plus} เพิ่มอุปกรณ์</button></div>
      </div>`;
  }

  const W = 640, H = 260, padL = 46, padR = 16, padT = 18, padB = 30;
  const n = points.length;
  const maxVal = Math.max(1, ...points.map(p=>Math.max(p.cost,p.rev))) * 1.18;

  const xAt = i => n===1 ? (padL + (W-padL-padR)/2) : padL + (i/(n-1))*(W-padL-padR);
  const yAt = v => (H-padB) - (v/maxVal)*(H-padT-padB);

  const costPath = points.map((p,i)=> `${i===0?'M':'L'} ${xAt(i).toFixed(1)} ${yAt(p.cost).toFixed(1)}`).join(' ');
  const revPath  = points.map((p,i)=> `${i===0?'M':'L'} ${xAt(i).toFixed(1)} ${yAt(p.rev).toFixed(1)}`).join(' ');

  // break-even crossing
  let crossIdx = -1;
  for(let i=0;i<points.length;i++){ if(points[i].rev >= points[i].cost && points[i].cost>0){ crossIdx=i; break; } }

  // gridlines (4 horizontal)
  const gridN = 4;
  let grid = '';
  for(let g=0; g<=gridN; g++){
    const val = (maxVal/gridN)*g;
    const y = yAt(val);
    grid += `<line x1="${padL}" y1="${y.toFixed(1)}" x2="${W-padR}" y2="${y.toFixed(1)}" stroke="#DCCEB2" stroke-width="1" stroke-dasharray="2,4"/>`;
    grid += `<text x="${padL-8}" y="${(y+3).toFixed(1)}" text-anchor="end" font-size="9.5" font-family="IBM Plex Mono, monospace" fill="#8a7660">${Math.round(val).toLocaleString('th-TH')}</text>`;
  }

  const firstDate = fmtDate(points[0].date);
  const lastDate = fmtDate(points[points.length-1].date);

  let crossMarker = '';
  if(crossIdx >= 0){
    const cx = xAt(crossIdx), cy = yAt(points[crossIdx].rev);
    crossMarker = `
      <line x1="${cx.toFixed(1)}" y1="${padT}" x2="${cx.toFixed(1)}" y2="${H-padB}" stroke="#BE7C3B" stroke-width="1.3" stroke-dasharray="3,3"/>
      <circle cx="${cx.toFixed(1)}" cy="${cy.toFixed(1)}" r="4.5" fill="#BE7C3B" stroke="#FBF7EF" stroke-width="2"/>
      <text x="${cx.toFixed(1)}" y="${padT-4}" text-anchor="middle" font-size="10.5" font-family="Fraunces, serif" font-weight="600" fill="#96601F">จุดคืนทุน</text>
    `;
  }

  return `
    <div class="chart-legend">
      <span><i class="swatch" style="background:#A8432B;"></i>ทุนสะสม</span>
      <span><i class="swatch" style="background:#6F7D52;"></i>รายรับสะสม</span>
    </div>
    <svg viewBox="0 0 ${W} ${H}" style="width:100%; height:auto; overflow:visible;">
      ${grid}
      <path d="${costPath}" fill="none" stroke="#A8432B" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/>
      <path d="${revPath}" fill="none" stroke="#6F7D52" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/>
      ${crossMarker}
      <text x="${padL}" y="${H-8}" font-size="9.5" font-family="IBM Plex Mono, monospace" fill="#8a7660">${firstDate}</text>
      <text x="${W-padR}" y="${H-8}" text-anchor="end" font-size="9.5" font-family="IBM Plex Mono, monospace" fill="#8a7660">${lastDate}</text>
    </svg>
  `;
}

